# Quote form (/[lang]/cotiza -> POST /api/quote). Same values as Civitas (docs/SUGGEST-SETUP.md there).
# Public: embedded at build time, redeploy after changing it. Add jesusgabriel.dev (and localhost) to the Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# One line, with literal \n, wrapped in quotes in .env.local
GOOGLE_PRIVATE_KEY=
# Civitas Sheet; rows go to the "Cotizaciones" tab
GOOGLE_SHEET_ID=
